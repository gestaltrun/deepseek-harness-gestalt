  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-platform-account": "workspace:^",
    "@deepseek-ai/dsh-remote-access": "workspace:^",
    "@deepseek-ai/dsh-remote-access-client": "workspace:^",
    "@deepseek-ai/dsh-remote-access-redis": "workspace:^",
    "@deepseek-ai/dsh-remote-protocol": "workspace:^",
