{
  "name": "@deepseek-ai/dsh-desktop",
  "productName": "DeepSeek Gestalt",
  "description": "DeepSeek Gestalt Desktop Host: Electron window around bundled dsh web",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "out/main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeiKeJieDeLiuLangMao/deepseek-harness-gestalt.git",
    "directory": "apps/desktop"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-main.mjs && electron out/main.mjs",
    "build:main": "node scripts/build-main.mjs",
    "package": "node scripts/build-main.mjs && electron-builder --publish never",
    "package:unsigned": "node scripts/build-main.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --publish never -c.mac.notarize=false"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-browser-runtime-electron": "workspace:^",
    "@deepseek-ai/dsh-client-ui-desktop": "workspace:^",
    "@deepseek-ai/dsh-platform-account": "workspace:^",
    "@deepseek-ai/dsh-platform-account-client": "workspace:^",
    "@deepseek-ai/dsh-remote-access": "workspace:^",
    "@deepseek-ai/dsh-remote-access-client": "workspace:^",
    "electron-updater": "^6.8.3",
    "@deepseek-ai/dsh-remote-protocol": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-platform-account-core": "workspace:^",
    "@deepseek-ai/dsh-platform-account-http": "workspace:^",
    "@deepseek-ai/dsh-remote-access-http": "workspace:^",
    "electron": "41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.gestalt.deepseek",
    "productName": "DeepSeek Gestalt",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main.mjs",
      "out/preload.cjs",
      "out/operated-platform.json",
      "cordis.patch.yml",
      "package.json"
    ],
    "afterPack": "./scripts/after-pack.mjs",
    "extraResources": [
      {
        "from": "cordis.patch.yml",
        "to": "cordis.patch.yml"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/node",
        "to": "node"
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "BeiKeJieDeLiuLangMao",
        "repo": "deepseek-harness-gestalt"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "zip",
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "artifactName": "DeepSeek-Gestalt-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "artifactName": "DeepSeekGestalt-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Gestalt"
    }
  }
}
