                      fill="none"
                      height="16"
                      viewBox="0 0 16 16"
                      width="16"
                      xmlns="http://www.w3.org/2000/svg"
                    />
                  </button>
                </div>
              </header>
              <div
                class="body"
                data-question-scroll="true"
              >
                <div
                  class="detail"
                >
                  <div
                    class="markdown"
                  >
                    <p>
                      该成员近 30 天无提交记录。
                    </p>
                  </div>
                </div>
                <div
                  class="options"
                  role="radiogroup"
                >
                  <button
                    aria-checked="false"
                    aria-label="移出"
                    class="option"
                    role="radio"
                    type="button"
                  >
                    <span
                      class="number"
                    >
                      1
                    </span>
                    <span
                      class="optionCopy"
                    >
                      <span
                        class="optionLine"
                      >
                        <span
                          class="optionLabel"
                        >
                          移出
                        </span>
                        <span
                          class="badge"
                        >
                          推荐
                        </span>
                        <span
                          class="description"
                        >
                          收回项目访问权。
                        </span>
                      </span>
                    </span>
                  </button>
                  <button
                    aria-checked="false"
                    aria-label="保留"
                    class="option"
                    role="radio"
                    type="button"
                  >
                    <span
                      class="number"
                    >
                      2
                    </span>
                    <span
                      class="optionCopy"
                    >
                      <span
                        class="optionLine"
                      >
                        <span
                          class="optionLabel"
                        >
                          保留
                        </span>
                        <span
                          class="description"
                        >
                          保持只读成员身份。
                        </span>
                      </span>
                    </span>
                  </button>
                  <div
                    class="customRow"
                  >
                    <span
                      aria-hidden="true"
                      class="number"
                    >
                      <svg
                        data-content="80a2f989"
