{
  "formatVersion": 1,
  "rules": [
    { "pattern": ".github/**", "area": "area/infra", "escalation": "workflow-or-planner-change" },
    { "pattern": "scripts/ci-*.ts", "area": "area/infra", "escalation": "workflow-or-planner-change" },
    { "pattern": "scripts/run-gates.ts", "area": "area/infra", "escalation": "workflow-or-planner-change" },
    { "pattern": "pnpm-lock.yaml", "area": "area/infra", "escalation": "package-manager-change" },
    { "pattern": "pnpm-workspace.yaml", "area": "area/infra", "escalation": "package-manager-change" },
    { "pattern": "package.json", "area": "area/infra", "escalation": "toolchain-change" },
    { "pattern": "tsconfig*.json", "area": "area/infra", "escalation": "toolchain-change" },
    { "pattern": "vendor/**", "area": "area/infra", "escalation": "vendor-change" },
    { "pattern": "packages/sdk/**", "area": "area/api", "escalation": "protocol-change" },
    { "pattern": "packages/core/session/**", "area": "area/session", "escalation": "session-lifecycle-change" },
    { "pattern": "packages/core/agent-loop/**", "area": "area/session", "escalation": "agent-loop-change" },
    { "pattern": "apps/**", "area": "area/web" },
    { "pattern": "packages/client/**", "area": "area/web" },
    { "pattern": "packages/browser/**", "area": "area/web" },
    { "pattern": "packages/host/**", "area": "area/web" },
    { "pattern": "packages/api/**", "area": "area/api" },
    { "pattern": "packages/acp/**", "area": "area/api" },
    { "pattern": "packages/llm/**", "area": "area/llm" },
    { "pattern": "packages/session/**", "area": "area/session" },
    { "pattern": "packages/subagent/**", "area": "area/subagent" },
    { "pattern": "packages/platform/**", "area": "area/platform" },
    { "pattern": "packages/tools/**", "area": "area/tools" },
    { "pattern": "packages/fs/**", "area": "area/tools" },
    { "pattern": "packages/shell/**", "area": "area/tools" },
    { "pattern": "packages/terminal/**", "area": "area/tools" },
    { "pattern": "packages/workflow/**", "area": "area/tools" },
    { "pattern": "docs/**", "area": "area/infra" },
    { "pattern": ".agents/**", "area": "area/infra" },
    { "pattern": "*.md", "area": "area/infra" }
  ]
}
