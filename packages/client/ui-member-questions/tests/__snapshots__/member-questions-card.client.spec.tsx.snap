                        height="12"
                        viewBox="0 0 16 16"
                        width="12"
                        xmlns="http://www.w3.org/2000/svg"
                      />
                    </span>
                    <div
                      class="field customInline"
                    >
                      <div
                        aria-hidden="true"
                        class="fieldMirror"
                      />
                      <textarea
